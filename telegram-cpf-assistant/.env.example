# telegram-cpf-assistant — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal chat id (use @userinfobot to discover it). Integer.
TELEGRAM_CHAT_ID=

# Timezone for scheduler and date formatting
TIMEZONE=America/Sao_Paulo

# SQLite database path (relative to project root or absolute)
DATABASE_PATH=./data/cpf_assistant.db

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── Garmin (domínio garmin, portado do garmin-dashboard) ──────────────────
# Diretório do cache de token OAuth do Garmin Connect. Para evitar re-2FA,
# copie o conteúdo de ~/.garminconnect/ (usado hoje pelo garmin-dashboard)
# para cá antes do primeiro start.
GARMIN_TOKEN_DIR=./data/garmin_session

# Só necessários se o cache acima não existir ou expirar (login fresco).
GARMIN_EMAIL=
GARMIN_PASSWORD=
